{
  "name": "acc-issues-backend",
  "version": "1.0.0",
  "description": "Backend for ACC Issues Display with 3-legged OAuth",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "setup-check": "node setup-check.js",
    "backup": "node scripts/backup.js",
    "backup:verify": "node scripts/verify-backup.js",
    "site:validate": "node scripts/validate-sites.js",
    "acc:list-hubs": "node scripts/acc-discovery.js list-hubs",
    "acc:list-projects": "node scripts/acc-discovery.js list-projects",
    "acc:list-accounts": "node scripts/acc-discovery.js list-accounts",
    "acc:list-companies": "node scripts/acc-discovery.js list-companies",
    "acc:list-project-users": "node scripts/acc-discovery.js list-project-users",
    "acc:find-company": "node scripts/acc-discovery.js find-company",
    "acc:inspect-assignees": "node scripts/acc-discovery.js inspect-assignees",
    "acc:list-asset-categories": "node scripts/acc-discovery.js list-asset-categories"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "multer": "^2.0.2",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
