# Copy to backend/.env and supply secrets before running Docker Compose.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_CALLBACK_URL=http://localhost:8080/api/auth/callback
SESSION_SECRET=
SITE_ACCESS_PIN=
SYNC_PIN=

# Optional deployment configuration
DEFAULT_SITE_ID=
SESSION_TTL_HOURS=24
SESSION_CLEANUP_MINUTES=15
ISSUE_REFRESH_INTERVAL_MINUTES=60
ISSUE_REFRESH_STARTUP_DELAY_SECONDS=30
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SITE_ACCESS_TTL_HOURS=24
SITE_ACCESS_MAX_ATTEMPTS=5
SITE_ACCESS_LOCKOUT_MINUTES=15
BACKUP_RETENTION_DAYS=30
