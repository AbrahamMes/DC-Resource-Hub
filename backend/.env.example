# Autodesk ACC API Credentials
# Register your app at https://aps.autodesk.com/myapps
APS_CLIENT_ID=your_client_id_here
APS_CLIENT_SECRET=your_client_secret_here
APS_CALLBACK_URL=http://localhost:3001/api/auth/callback

# Placeholder values for ACC API queries
ACC_PROJECT_ID=your_project_id_here
ACC_ASSIGNED_TO_ID=your_assigned_to_id_here

# Server Configuration
PORT=3001
SESSION_SECRET=your_random_session_secret_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Assets Sync Security PIN
# Used to confirm intention before re-syncing assets from ACC API
SYNC_PIN=1725
