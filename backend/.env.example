# Autodesk ACC API Credentials
# Register your app at https://aps.autodesk.com/myapps
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_CALLBACK_URL=http://localhost:3001/api/auth/callback

# Placeholder values for ACC API queries
ACC_PROJECT_ID=your_project_id_here
ACC_ASSIGNED_TO_ID=your_assigned_to_id_here

# Server Configuration
PORT=3001
DATA_DIR=./data
SITES_CONFIG_PATH=./config/sites.json
DEFAULT_SITE_ID=
WEB_CONCURRENCY=1
SESSION_SECRET=
SESSION_TTL_HOURS=24
SESSION_CLEANUP_MINUTES=15
ISSUE_REFRESH_INTERVAL_MINUTES=60
ISSUE_REFRESH_STARTUP_DELAY_SECONDS=30
TRUST_PROXY=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Front-door website PIN (separate from the administrative SYNC_PIN)
SITE_ACCESS_PIN=
SITE_ACCESS_TTL_HOURS=24
SITE_ACCESS_MAX_ATTEMPTS=5
SITE_ACCESS_LOCKOUT_MINUTES=15

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Assets Sync Security PIN
# Used to confirm intention before re-syncing assets from ACC API
SYNC_PIN=
